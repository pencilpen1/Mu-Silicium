[Defines]
  INF_VERSION = 0x00010005
  BASE_NAME = MusbHostDxe
  FILE_GUID = C663BDBA-795F-4BB0-9F34-7F66D93C3C1D
  MODULE_TYPE = DXE_DRIVER
  VERSION_STRING = 0.3
  ENTRY_POINT = MusbHostEntry

[Sources]
  MusbHost.c
  MusbHost.h
  LancelotUsb.c
  UsbStatus.c
  UsbStatus.h

[Packages]
  MdePkg/MdePkg.dec
  MediaTekPkg/MediaTekPkg.dec
  SiliciumPkg/SiliciumPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  BaseLib
  BaseMemoryLib
  IoLib
  TimerLib
  BootLogLib
  CacheMaintenanceLib
  MemoryAllocationLib
  PrintLib

[Protocols]
  gMediaTekUsbRoleProtocolGuid
  gEfiUsb2HcProtocolGuid
  gEfiDevicePathProtocolGuid
  gEfiCpuArchProtocolGuid
  gEfiTimerArchProtocolGuid
  gMediaTekClockProtocolGuid

[Guids]
  gEfiEventExitBootServicesGuid

[Depex]
  gEfiCpuArchProtocolGuid AND gEfiTimerArchProtocolGuid AND
  gMediaTekClockProtocolGuid
