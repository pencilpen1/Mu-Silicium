[Defines]
  INF_VERSION = 0x00010005
  BASE_NAME = MusbDiagnosticDualRoleDxe
  FILE_GUID = AB11A55B-440A-40AA-8D39-17EA4C3E015B
  MODULE_TYPE = DXE_DRIVER
  VERSION_STRING = 0.3
  ENTRY_POINT = MusbDiagnosticEntry

[Sources]
  MusbDiagnostic.c

[Packages]
  MdePkg/MdePkg.dec
  MediaTekPkg/MediaTekPkg.dec
  SiliciumPkg/SiliciumPkg.dec

[LibraryClasses]
  BootLogLib
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  BaseLib
  BaseMemoryLib
  IoLib
  TimerLib

[BuildOptions]
  *_*_*_CC_FLAGS = -DMUSB_MANAGED_ROLE=1

[Guids]
  gEfiEventExitBootServicesGuid

[Protocols]
  gEfiCpuArchProtocolGuid
  gEfiTimerArchProtocolGuid
  gMediaTekUsbRoleProtocolGuid

[Depex]
  gEfiCpuArchProtocolGuid AND gEfiTimerArchProtocolGuid AND gMediaTekUsbRoleProtocolGuid
